// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree for the Planet Computers Gemini PDA (MediaTek MT6797),
 * used as U-Boot's control device tree only.
 *
 * This blob is appended to the boot image. The vendor LK bootloader rewrites
 * /memory, patches every CPU node's clock-frequency and adds its "mblock-*"
 * reserved-memory regions before handing it back to U-Boot in x0. The Linux
 * kernel loads its own, full device tree from the rootfs, so this tree only
 * needs to describe what U-Boot itself drives: the debug UART and the eMMC.
 *
 * It is deliberately self-contained (no SoC .dtsi include): there is no clock,
 * pinctrl or power-domain driver for MT6797 in U-Boot, so clocks are modelled
 * as fixed-clocks and pins/regulators are left as LK configured them.
 */

/dts-v1/;

/ {
	model = "Planet Computers Gemini PDA";
	compatible = "planet,gemini-pda", "mediatek,mt6797";
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	/*
	 * LK leaves its framebuffer live in DRAM and records its base in the
	 * /chosen videolfb atags. These are the hardware-verified parameters
	 * (ixoo's mainline simplefb runs on them); board_init() overwrites the
	 * reg base from the atag at runtime, keeping this as the default.
	 * TODO(hw-verify): base/size/stride confirmed against ixoo's
	 * lk-simplefb.dtso; re-check if the panel or LK revision differs.
	 */
	framebuffer: framebuffer@7dfb0000 {
		compatible = "simple-framebuffer";
		reg = <0 0x7dfb0000 0 0x1f90000>;
		width = <1080>;
		height = <2160>;
		stride = <4352>;
		format = "a8r8g8b8";
		status = "okay";
	};

	/*
	 * LK's target_fdt_cpus() iterates the CPU nodes and bails out on the
	 * first one that is missing clock-frequency, so all ten must carry it.
	 * The values are nominal; LK clamps them to each cluster's maximum.
	 */
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			clock-frequency = <1400000000>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			clock-frequency = <1400000000>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			clock-frequency = <1400000000>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			clock-frequency = <1400000000>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			clock-frequency = <1400000000>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			clock-frequency = <1400000000>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			clock-frequency = <1400000000>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			clock-frequency = <1400000000>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			reg = <0x200>;
			clock-frequency = <2500000000>;
		};

		cpu@201 {
			device_type = "cpu";
			compatible = "arm,cortex-a72";
			reg = <0x201>;
			clock-frequency = <2500000000>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		/* Placeholder; LK rewrites /memory with the real banks. */
		reg = <0 0x40000000 1 0>;
	};

	/*
	 * Static pre-LK carve-outs (CCCI/ramoops/SCP/SPM), mirrored from the
	 * Linux DTS so U-Boot's lmb never loads images over them.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		memory@40000000 {
			reg = <0 0x40000000 0 0x1000>;
			no-map;
		};

		memory@44400000 {
			reg = <0 0x44400000 0 0x500000>;
			no-map;
		};

		memory@46000000 {
			reg = <0 0x46000000 0 0x400000>;
			no-map;
		};
	};

	/*
	 * MSDC0 (eMMC) source clocks. There is no MT6797 clock driver in U-Boot,
	 * so model them as fixed-clocks that LK has already enabled. 200 MHz is
	 * the vendor MSDC50_0 source rate; the controller is capped to 25 MHz
	 * (max-frequency below), which the divider derives from this.
	 * TODO(hw-verify): confirm the MSDC50_0 source rate; any value >= the
	 * 25 MHz cap works, the divider adapts.
	 */
	msdc0_src: clock-msdc0-src {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};

	msdc0_hclk: clock-msdc0-hclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		uart0: serial@11002000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x400>;
			/*
			 * No clocks phandle: serial_mtk falls back to this
			 * fixed rate (the 26 MHz UART baud clock LK leaves on).
			 * TODO(hw-verify): confirm the UART0 baud clock is
			 * 26 MHz by checking the banner prints at 921600.
			 */
			clock-frequency = <26000000>;
			status = "okay";
		};

		mmc0: mmc@11230000 {
			compatible = "mediatek,mt6797-mmc";
			reg = <0 0x11230000 0 0x10000>;
			clocks = <&msdc0_src>, <&msdc0_hclk>;
			clock-names = "source", "hclk";
			bus-width = <8>;
			max-frequency = <25000000>;
			cap-mmc-highspeed;
			non-removable;
			no-sd;
			no-sdio;
			status = "okay";
		};

		watchdog@10007000 {
			/*
			 * LK leaves the RGU watchdog running (10 s timeout).
			 * TODO(hw-verify): assumes the shipped LK was built
			 * without LK_WDT_DISABLE (it enables the WDT in
			 * mtk_wdt_init() otherwise).
			 */
			compatible = "mediatek,mt6589-wdt";
			reg = <0 0x10007000 0 0x100>;
		};

		/*
		 * infracfg SSUSB gates (sys/ref/bus) consumed by the MTU3
		 * controller. A tiny control-DT-only clock provider, not a full
		 * MT6797 clock driver (see drivers/clk/mediatek/clk-mt6797.c).
		 * Local clock cells: 0 = sys_ck, 1 = ref_ck, 2 = mcu_ck (bus).
		 * Its probe also reparents the topckgen ssusb_top_sys mux.
		 */
		usb_clk: clock-controller@10001000 {
			compatible = "mediatek,mt6797-ssusb-cg";
			reg = <0 0x10001000 0 0x1000>;
			#clock-cells = <1>;
		};

		usb_phy: t-phy@11290000 {
			compatible = "mediatek,mt6797-tphy",
				     "mediatek,generic-tphy-v1";
			reg = <0 0x11290000 0 0x800>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "okay";

			u2port0: usb-phy@11290800 {
				reg = <0 0x11290800 0 0x100>;
				#phy-cells = <1>;
				/*
				 * VBUS/session is delivered by firmware, not
				 * sensed by the T-PHY, so force a valid B-device
				 * session (mirrors the Linux local quirk). The
				 * "ref" clock is the SSUSB_REF infra gate that
				 * the MTU3 node already enables, so it is omitted
				 * here (optional in the driver).
				 * TODO(hw-verify): confirm it enumerates.
				 */
				mediatek,force-b-session-valid;
				status = "okay";
			};
		};

		/*
		 * MTU3 device controller on the left USB-C port. The
		 * "mediatek,mtu3" fallback matches U-Boot's driver. Peripheral,
		 * high-speed only (no USB3 PHY wired). ippc is at 0x11280700.
		 */
		ssusb: usb@11271000 {
			compatible = "mediatek,mt6797-mtu3", "mediatek,mtu3";
			reg = <0 0x11271000 0 0x3000>,
			      <0 0x11280700 0 0x100>;
			reg-names = "mac", "ippc";
			clocks = <&usb_clk 0>, <&usb_clk 1>, <&usb_clk 2>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck";
			phys = <&u2port0 1>; /* PHY_TYPE_USB2 */
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			status = "okay";
		};
	};
};
