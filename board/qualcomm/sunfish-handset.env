# Maintainer's repartitioned Pixel 4a only; generic phones use qcom-phone.env.
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0

# This handset preserves Android userdata and keeps Linux in a separate partition.
preboot=scsi scan; if part start scsi 0 linux userdata_start && part size scsi 0 linux userdata_size; then blkmap create root; blkmap map root 0 0x${userdata_size} linear scsi 0 0x${userdata_start}; else echo Missing handset linux partition; fi
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo Enabled U-Boot console serial gadget
bootcmd=bootmenu 5; bootefi bootmgr; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Never execute a stale buffer when loading the separate helper fails.
# tools/sunfish-slotflip/build.py installs the payload at this canonical path.
boot_android=if load blkmap 0:1 ${kernel_addr_r} /EFI/sunfish/slotflip.efi; then bootefi ${kernel_addr_r}:${filesize} ${fdtcontroladdr}; echo Android helper returned or failed; pause; else echo Missing /EFI/sunfish/slotflip.efi - install the slotflip payload; pause; fi

bootmenu_0=BengalOS=bootefi bootmgr; pause
bootmenu_1=Android (slot B)=run boot_android
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Enable fastboot mode=run fastboot
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Dump clocks=clk dump; pause
bootmenu_8=Dump environment=printenv; pause
bootmenu_9=Board info=bdinfo; pause
bootmenu_10=Dump bootargs=fdt print /chosen bootargs; pause
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
