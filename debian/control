Maintainer: realni <ant@ict4.cz>
Build-Depends: debhelper-compat (= 13), build-essential, bc, bison, flex,
 libssl-dev, uuid-dev, device-tree-compiler, python3, python3-dev, python3-setuptools,
 python3-pyelftools, swig, libgnutls28-dev
Standards-Version: 4.6.2

Package: u-boot-gemini-simplefb
Architecture: arm64
Depends: ${misc:Depends}
Description: U-Boot for the Planet Gemini PDA (MediaTek MT6797)
 Built natively on aarch64 (no cross compiler) from the gemini-simplefb-cells
 branch: enables the kernel simple-framebuffer at boot and declares the /chosen
 cells before the simplefb fixup. Ships the raw u-boot.bin, the LK-compatible
 Android boot image u-boot-gemini-boot.img and the DTB under
 /usr/lib/u-boot-gemini/.
