#!/usr/bin/env python3
# Minimal Android boot image v0 writer: the subset of AOSP mkbootimg(1) that
# board/planet/gemini-pda/mkbootimg.sh uses. Avoids a distro mkbootimg
# build-dependency on the OBS Debian builder. The classic boot_img_hdr (v0)
# layout is fixed and stable.
import argparse, hashlib, struct

p = argparse.ArgumentParser()
p.add_argument('--kernel', required=True)
p.add_argument('--ramdisk')
p.add_argument('--second')
p.add_argument('--base', default='0x10000000')
p.add_argument('--kernel_offset', default='0x00008000')
p.add_argument('--ramdisk_offset', default='0x01000000')
p.add_argument('--second_offset', default='0x00f00000')
p.add_argument('--tags_offset', default='0x00000100')
p.add_argument('--pagesize', default='2048')
p.add_argument('--cmdline', default='')
p.add_argument('--board', default='')
p.add_argument('--header_version', default='0')
p.add_argument('-o', '--output', required=True)
a = p.parse_args()

def num(x):
    return int(x, 0)

def rd(path):
    if not path:
        return b''
    with open(path, 'rb') as f:
        return f.read()

base = num(a.base)
page = num(a.pagesize)
kernel, ramdisk, second = rd(a.kernel), rd(a.ramdisk), rd(a.second)

def pad(b):
    n = (-len(b)) % page
    return b + b'\x00' * n

# id = sha1 over (payload, size) triples, as AOSP mkbootimg does.
sha = hashlib.sha1()
for blob in (kernel, ramdisk, second):
    sha.update(blob)
    sha.update(struct.pack('<I', len(blob)))
img_id = sha.digest()[:20] + b'\x00' * 12

cmd = a.cmdline.encode()
hdr = struct.pack(
    '<8sIIIIIIIIII16s512s32s1024s',
    b'ANDROID!',
    len(kernel), base + num(a.kernel_offset),
    len(ramdisk), base + num(a.ramdisk_offset),
    len(second), base + num(a.second_offset),
    base + num(a.tags_offset),
    page,
    num(a.header_version),
    0,                              # os_version
    a.board.encode()[:16],
    cmd[:512],
    img_id,
    cmd[512:][:1024],
)

with open(a.output, 'wb') as f:
    f.write(pad(hdr))
    f.write(pad(kernel))
    f.write(pad(ramdisk))
    f.write(pad(second))
print('wrote', a.output)
